<Window x:Class="DeGoogleKit.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeGoogle Kit account"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostBtn}" Click="OnCancel" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Sign in" Style="{StaticResource GhostBtn}" Click="OnSignIn" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Create account" Style="{StaticResource PrimaryBtn}" Click="OnSignUp" Padding="14,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Free account on any PC" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"
                       Text="Email and password via Supabase Auth (not Google). Free: backs up your plan and checklist. If you paid for Pro, that follows this account too."/>
            <StackPanel x:Name="ProjectPanel" Margin="0,0,0,10">
                <TextBlock Text="Supabase project URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="UrlBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10"
                         Text="https://YOUR-PROJECT.supabase.co"/>
                <TextBlock Text="Anon public key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="AnonBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
            </StackPanel>
            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="EmailBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Password (at least 8 characters)" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="36" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="AccountConsentBox" Margin="0,12,0,0">
                <TextBlock TextWrapping="Wrap" Width="450"
                           Text="Create account: I agree that Opolyonix Corp may process my email, plan, and checklist via Supabase (not Google). I can delete the account later."/>
            </CheckBox>
            <Button Content="Read privacy notice" Style="{StaticResource GhostBtn}" Click="OnOpenPrivacy" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"/>
        </StackPanel>
    </DockPanel>
</Window>
