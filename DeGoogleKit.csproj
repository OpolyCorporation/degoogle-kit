<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeGoogleKit</AssemblyName>
    <Product>DeGoogle Kit</Product>
    <AssemblyTitle>DeGoogle Kit</AssemblyTitle>
    <Company>Opolyonix Corp</Company>
    <Authors>Opolyonix Corp</Authors>
    <Copyright>Copyright © Opolyonix Corp</Copyright>
    <Description>Windows assistant to leave Google on your terms. Local-first scan, plan, and Takeout tools. Never auto-deletes Google data.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>0.4.0</Version>
    <InformationalVersion>0.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Licensing\**" />
    <Compile Remove="license-api\**" />
    <Compile Remove="supabase\**" />
    <None Remove="Licensing\**" />
    <None Remove="license-api\**" />
    <None Remove="supabase\**" />
    <EmbeddedResource Remove="Licensing\**" />
    <EmbeddedResource Remove="license-api\**" />
    <EmbeddedResource Remove="supabase\**" />
    <Page Remove="Licensing\**" />
    <Page Remove="license-api\**" />
    <Page Remove="supabase\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\brand.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="updates\feed.url" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="cloud\supabase.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="Licensing\DeGoogleKit.Licensing.csproj" />
  </ItemGroup>

</Project>
