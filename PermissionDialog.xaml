<Window x:Class="DeGoogleKit.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Permission"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="RememberBox" Content="Remember this choice" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Not now" Style="{StaticResource GhostBtn}" Click="OnDeny" Padding="18,8" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="AllowBtn" Content="Allow" Style="{StaticResource PrimaryBtn}" Click="OnAllow" Padding="18,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ChangeBadge" Foreground="{StaticResource Warn}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="Collapsed" Text="This will change something on this PC."/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,14"/>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Access" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="AccessText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="What changes" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
                    <TextBlock x:Name="ChangeText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
