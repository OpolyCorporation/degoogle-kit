<Window x:Class="DeGoogleKit.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome — DeGoogle Kit"
        Height="800" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Bottom">
            <CheckBox x:Name="AgeBox" Content="I am 16 or older, or I have a parent/guardian’s consent." Margin="0,0,0,8"/>
            <CheckBox x:Name="LocalBox" Content="I understand this app stores its files on this PC (AppData\DeGoogleKit)." Margin="0,0,0,8"/>
            <CheckBox x:Name="ScanBox" Content="Allow a read-only scan of this PC (programs, browser, Google folders, DNS)." Margin="0,0,0,8"/>
            <CheckBox x:Name="PrivacyBox" Content="I have read the privacy notice below and I agree." Margin="0,0,0,8"/>
            <CheckBox x:Name="SupabaseBox" Margin="0,0,0,14">
                <TextBlock TextWrapping="Wrap" Text="Optional: allow an account backup later (not Google). Leave unticked to stay fully local."/>
            </CheckBox>
            <CheckBox x:Name="DesktopShortcutBox" Content="Add a Desktop shortcut" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartMenuShortcutBox" Content="Add a Start menu shortcut" IsChecked="True" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostBtn}" Click="OnCancel" Margin="0,0,8,0" Padding="18,8"/>
                <Button Content="Agree and continue" Style="{StaticResource PrimaryBtn}" Click="OnAgree" Padding="18,8"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="56" Height="56" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/brand.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="14,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DeGoogle Kit" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Leave Google without wrecking your PC" Foreground="{StaticResource Accent}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="How it works" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"
                           Text="Nothing is deleted from Google automatically. You choose every uninstall and disconnect step."/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="14">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run FontWeight="SemiBold" Text="1. Scan"/> — see what Google software is on this PC.</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run FontWeight="SemiBold" Text="2. Plan"/> — pick replacements (mail, photos, browser…).</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"><Run FontWeight="SemiBold" Text="3. Takeout"/> — drop your Google export; we parse it only on this PC.</TextBlock>
                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="4. Disconnect"/> — after counts match, you disconnect on Google’s site.</TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="Privacy notice" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Required boxes start unchecked. Scroll and tick the ones you agree with." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Border Style="{StaticResource CardBorder}">
                    <TextBox x:Name="NoticeBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Height="220" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Text}" FontSize="13"
                             CaretBrush="{StaticResource Text}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
